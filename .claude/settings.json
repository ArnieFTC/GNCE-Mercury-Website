{
  "enabledPlugins": {
    "hallmark@hallmark": true,
    "tastemaker@codeswithroh": true,
    "taste-skill@taste-skill": true,
    "accesslint@accesslint": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true
  },
  "extraKnownMarketplaces": {
    "hallmark": {
      "source": {
        "source": "github",
        "repo": "nutlope/hallmark"
      }
