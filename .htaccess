# mercury26413.org runs on Hostinger, which reads this file (Apache syntax).
# Everything here helps AI agents read the site; every block is inside <IfModule>, so a server without
# a module skips that block instead of failing. GitHub Pages ignores this file.
# The block between "agent:begin" and "agent:end" is written by tools/agent_files.py: don't edit it by hand.

<IfModule mod_mime.c>
  AddType text/markdown .md
  AddCharset UTF-8 .md .txt .json .xml
  # "team.html.md" has two extensions: make sure the server doesn't call it HTML
  <FilesMatch "\.md$">
    ForceType text/markdown
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The MCP server (mcp.php) answers at /mcp. Its server card is the file .well-known/mcp/server-card.json
  # (written by tools/agent_files.py from mcp.php), also at /mcp/server-card.
  RewriteRule ^mcp/server-card/?$ .well-known/mcp/server-card.json [L]
  RewriteRule ^mcp/?$ mcp.php [L]

  # Agents that ask for Markdown (Accept: text/markdown) get the page's Markdown version, made by
  # tools/agent_files.py. Browsers never ask for Markdown, so they keep getting the HTML. An agent that lists
  # text/markdown at q=0, or ranks it below a full-strength text/html, gets the HTML too.
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{HTTP_ACCEPT} !text/markdown[^,]*;\s*q\s*=\s*0(\.0*)?\s*(,|$) [NC]
  RewriteCond %{HTTP_ACCEPT} !(^|,)\s*text/html\s*(;\s*q\s*=\s*1(\.0*)?\s*)?(,|$) [NC,OR]
  RewriteCond %{HTTP_ACCEPT} !text/markdown[^,]*;\s*q\s*=\s*0\. [NC]
  RewriteRule ^(index\.html)?$ index.html.md [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{HTTP_ACCEPT} !text/markdown[^,]*;\s*q\s*=\s*0(\.0*)?\s*(,|$) [NC]
  RewriteCond %{HTTP_ACCEPT} !(^|,)\s*text/html\s*(;\s*q\s*=\s*1(\.0*)?\s*)?(,|$) [NC,OR]
  RewriteCond %{HTTP_ACCEPT} !text/markdown[^,]*;\s*q\s*=\s*0\. [NC]
  RewriteCond %{REQUEST_FILENAME}.md -f
  RewriteRule ^(.+\.html)$ $1.md [L]
</IfModule>

<IfModule mod_headers.c>
  # A page's address can return HTML or Markdown depending on the Accept header
  <FilesMatch "\.(html|md)$">
    Header append Vary Accept
  </FilesMatch>
  # Markdown copies: say how the content may be used (same as robots.txt), and keep shared caches from
  # handing a Markdown answer to a browser
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=utf-8"
    Header set Content-Signal "search=yes, ai-input=yes, ai-train=no"
    Header set Cache-Control "private, max-age=300"
  </FilesMatch>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
  # Files meant for agents can be read from any site
  <FilesMatch "\.(md|txt|xml|json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Every page points agents to the site guide (llms.txt) and the MCP server card. Values with quotes inside are
  # wrapped in single quotes: LiteSpeed (Hostinger) keeps backslashes in "...\"..." literally.
  <FilesMatch "\.html$">
    Header append Link '<https://mercury26413.org/llms.txt>; rel="describedby"; type="text/plain"'
    Header append Link '<https://mercury26413.org/.well-known/mcp/server-card.json>; rel="service-desc"; type="application/json"'
  </FilesMatch>

  # agent:begin: each page points to its Markdown version
  <Files "index.html">
    Header append Link '<https://mercury26413.org/index.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "seasons.html">
    Header append Link '<https://mercury26413.org/seasons.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "2026-2027.html">
    Header append Link '<https://mercury26413.org/seasons/2026-2027.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "2025-2026.html">
    Header append Link '<https://mercury26413.org/seasons/2025-2026.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "2024-2025.html">
    Header append Link '<https://mercury26413.org/seasons/2024-2025.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "team.html">
    Header append Link '<https://mercury26413.org/team.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "outreach.html">
    Header append Link '<https://mercury26413.org/outreach.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "news.html">
    Header append Link '<https://mercury26413.org/news.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "partners.html">
    Header append Link '<https://mercury26413.org/partners.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "resources.html">
    Header append Link '<https://mercury26413.org/resources.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "contact.html">
    Header append Link '<https://mercury26413.org/contact.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  <Files "terms.html">
    Header append Link '<https://mercury26413.org/terms.html.md>; rel="alternate"; type="text/markdown"'
  </Files>
  # agent:end
</IfModule>
